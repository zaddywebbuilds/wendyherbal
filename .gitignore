# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and is how anyone knows what to set.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Source video reels (~706MB, one file is 124MB — over GitHub's 100MB hard limit).
# They stay on disk for local dev; host them on Supabase Storage or a CDN for production.
/public/media/videos/*.mp4

# Local Google connection store (encrypted, but still a credential)
/.data/

# Photographs uploaded in local development; production uses Vercel Blob
/public/media/uploads/

.vercel
.env*
