# Copy to .env.local and fill in. Never commit .env.local.

# --- Admin sign-in (required) ---
# Without both of these the dashboard stays locked, which is deliberate:
# the Google connect button must never sit on an open page.
ADMIN_PASSWORD=
# Any long random string. Signs the session cookie and encrypts the stored
# Google token, so changing it logs everyone out and drops the connection.
# Generate one with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
ADMIN_SECRET=

# --- Google OAuth (the "Connect my Google account" button) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application). Authorised redirect URI must be exactly:
#   http://localhost:3000/api/google/callback        (local)
#   https://your-domain.com/api/google/callback      (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only for "use a sheet I already have". Enable the Google Picker API and
# create an API key. Without this the owner can still create a new order book,
# she just cannot pick an existing file.
NEXT_PUBLIC_GOOGLE_API_KEY=

# --- Connection storage ---
# The Google refresh token has to outlive a restart. Locally it goes in
# .data/ automatically. On Vercel the filesystem is read-only, so add a
# Vercel KV / Upstash Redis store and paste its two values here.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search engines are blocked until this is "true". Leave it unset until the
# legal pages exist, products have photos, and the catalogue has had a NAFDAC
# review — de-indexing after the fact is slow. See DEPLOY.md.
NEXT_PUBLIC_ALLOW_INDEXING=

# --- Payments ---
# Bank transfer only; no gateway keys needed. Bank details live in
# src/lib/constants.ts (BANK_DETAILS) and are not secret — they are the same
# details printed on the public price list.

# --- Service account (optional alternative to the OAuth button) ---
# Only if you prefer wiring a shared sheet by hand instead. See the README.
# GOOGLE_SHEETS_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
